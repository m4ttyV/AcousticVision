<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AcousticVision.App"
             RequestedThemeVariant="Default">
    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml"/>

        <Style Selector="Button">
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="MinWidth" Value="140"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>

        <Style Selector="Button.nav">
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="MinWidth" Value="220"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style Selector="Button.action">
            <Setter Property="MinWidth" Value="170"/>
            <Setter Property="MinHeight" Value="36"/>
        </Style>

        <Style Selector="Border.card">
            <Setter Property="Background" Value="{DynamicResource AppCardBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppCardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="14"/>
        </Style>
    </Application.Styles>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="AppWindowBackgroundBrush">#F5F7FA</SolidColorBrush>
                    <SolidColorBrush x:Key="AppSidebarBackgroundBrush">#111827</SolidColorBrush>
                    <SolidColorBrush x:Key="AppHeaderBackgroundBrush">#1F2937</SolidColorBrush>
                    <SolidColorBrush x:Key="AppHeaderPrimaryTextBrush">White</SolidColorBrush>
                    <SolidColorBrush x:Key="AppHeaderSecondaryTextBrush">#D1D5DB</SolidColorBrush>
                    <SolidColorBrush x:Key="AppSidebarTextBrush">#E5E7EB</SolidColorBrush>
                    <SolidColorBrush x:Key="AppCardBackgroundBrush">White</SolidColorBrush>
                    <SolidColorBrush x:Key="AppCardBorderBrush">#D0D7DE</SolidColorBrush>
                    <SolidColorBrush x:Key="AppSecondaryTextBrush">#4B5563</SolidColorBrush>
                    <SolidColorBrush x:Key="AppStatusTextBrush">DarkBlue</SolidColorBrush>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="AppWindowBackgroundBrush">#0F172A</SolidColorBrush>
                    <SolidColorBrush x:Key="AppSidebarBackgroundBrush">#111827</SolidColorBrush>
                    <SolidColorBrush x:Key="AppHeaderBackgroundBrush">#1F2937</SolidColorBrush>
                    <SolidColorBrush x:Key="AppHeaderPrimaryTextBrush">#F8FAFC</SolidColorBrush>
                    <SolidColorBrush x:Key="AppHeaderSecondaryTextBrush">#CBD5E1</SolidColorBrush>
                    <SolidColorBrush x:Key="AppSidebarTextBrush">#E5E7EB</SolidColorBrush>
                    <SolidColorBrush x:Key="AppCardBackgroundBrush">#1E293B</SolidColorBrush>
                    <SolidColorBrush x:Key="AppCardBorderBrush">#475569</SolidColorBrush>
                    <SolidColorBrush x:Key="AppSecondaryTextBrush">#CBD5E1</SolidColorBrush>
                    <SolidColorBrush x:Key="AppStatusTextBrush">#93C5FD</SolidColorBrush>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
