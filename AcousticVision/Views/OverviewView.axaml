<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AcousticVision.ViewModels"
             x:Class="AcousticVision.Views.OverviewView"
             x:DataType="vm:OverviewViewModel">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="12">

            <Border Classes="card">
                <StackPanel Spacing="8">
                    <TextBlock Text="Обзор системы"
                               FontSize="22"
                               FontWeight="Bold"/>

                    <TextBlock TextWrapping="Wrap"
                               Text="AcousticVision — прототип программной системы для анализа акустических характеристик речи в помещении. Система использует геометрию помещения, свойства его поверхностей, параметры источника и положение приёмника для получения оценочных характеристик акустической обстановки."/>
                </StackPanel>
            </Border>

            <Border Classes="card">
                <StackPanel Spacing="8">
                    <TextBlock Text="Как выполняется оценка"
                               FontSize="18"
                               FontWeight="Bold"/>

                    <TextBlock TextWrapping="Wrap"
                               Text="На текущем этапе прототип оценивает акустические условия по двум основным направлениям: по общим параметрам помещения и по взаимному расположению источника и приёмника."/>
                </StackPanel>
            </Border>

            <Border Classes="card">
                <StackPanel Spacing="8">
                    <TextBlock Text="1. Оценка времени реверберации RT60"
                               FontSize="18"
                               FontWeight="Bold"/>

                    <TextBlock TextWrapping="Wrap"
                               Text="Для помещения рассчитывается время реверберации RT60 — интервал, за который уровень звука после выключения источника уменьшается на 60 дБ. На практике RT60 позволяет оценить, насколько помещение является «гулким» или, наоборот, акустически комфортным для восприятия речи."/>

                    <TextBlock TextWrapping="Wrap"
                               Text="Расчёт выполняется по статистической модели на основе объёма помещения и суммарного эквивалентного звукопоглощения его поверхностей. Чем больше звукопоглощение материалов, тем меньше RT60 и тем, как правило, выше разборчивость речи."/>
                </StackPanel>
            </Border>

            <Border Classes="card">
                <StackPanel Spacing="8">
                    <TextBlock Text="2. Учёт расстояния между источником и приёмником"
                               FontSize="18"
                               FontWeight="Bold"/>

                    <TextBlock TextWrapping="Wrap"
                               Text="Координаты источника и приёмника используются для определения расстояния между ними. На основе этого расстояния рассчитывается оценка ослабления прямого сигнала: при увеличении дистанции уровень прямого звука в точке приёмника уменьшается."/>

                    <TextBlock TextWrapping="Wrap"
                               Text="Таким образом, даже при одинаковом RT60 условия восприятия речи могут отличаться: если источник расположен слишком далеко от приёмника, полезный сигнал в точке прослушивания становится слабее, что может ухудшать субъективное качество восприятия."/>
                </StackPanel>
            </Border>

            <Border Classes="card">
                <StackPanel Spacing="8">
                    <TextBlock Text="Итоговая интерпретация результата"
                               FontSize="18"
                               FontWeight="Bold"/>

                    <TextBlock TextWrapping="Wrap"
                               Text="Итоговая рекомендация формируется с учётом двух факторов: общего акустического состояния помещения (через RT60) и локальных условий в точке приёмника (через расстояние и условный уровень прямого сигнала). Такой подход позволяет получить не только численные значения, но и текстовую оценку качества выбранной конфигурации."/>
                </StackPanel>
            </Border>

            <Border Classes="card">
                <StackPanel Spacing="8">
                    <TextBlock Text="Текущий состав модулей"
                               FontSize="18"
                               FontWeight="Bold"/>

                    <TextBlock Text="• помещения;" />
                    <TextBlock Text="• поверхности помещения;" />
                    <TextBlock Text="• материалы и фактуры;" />
                    <TextBlock Text="• источники и приёмники;" />
                    <TextBlock Text="• тестовые модели;" />
                    <TextBlock Text="• модуль анализа и формирования рекомендаций." />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>