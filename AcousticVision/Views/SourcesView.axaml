<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AcousticVision.ViewModels"
             x:Class="AcousticVision.Views.SourcesView"
             x:DataType="vm:SourcesViewModel">

    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" ColumnDefinitions="*" RowSpacing="12">
        <TextBlock Grid.Row="0" Text="Раздел: Источники звука" FontSize="20" FontWeight="Bold"/>

        <Border Grid.Row="1" Classes="card">
            <StackPanel Spacing="8">
                <TextBlock Text="Добавление источника" FontWeight="Bold"/>
                <TextBox Watermark="Название источника" Text="{Binding NewSourceName}"/>
                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                    <TextBox Grid.Column="0" Watermark="Громкость" Text="{Binding NewVolume}"/>
                    <TextBox Grid.Column="1" Watermark="Артикуляция (0..1, необязательно)" Text="{Binding NewArticle}"/>
                </Grid>
                <TextBox Watermark="Дополнительные свойства" Text="{Binding NewProperties}"/>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Classes="action" Content="Добавить" Command="{Binding AddSourceCommand}"/>
                    <Button Classes="action" Content="Обновить список" Command="{Binding LoadCommand}"/>
                    <Button Classes="action" Content="Удалить выбранный" Command="{Binding DeleteSelectedCommand}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Classes="card">
            <StackPanel Spacing="8">
                <TextBlock Text="Изменение выбранного источника" FontWeight="Bold"/>
                <TextBox Watermark="Название источника" Text="{Binding EditSourceName}"/>
                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                    <TextBox Grid.Column="0" Watermark="Громкость" Text="{Binding EditVolume}"/>
                    <TextBox Grid.Column="1" Watermark="Артикуляция (0..1, необязательно)" Text="{Binding EditArticle}"/>
                </Grid>
                <TextBox Watermark="Дополнительные свойства" Text="{Binding EditProperties}"/>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Classes="action" Content="Сохранить изменения" Command="{Binding UpdateSelectedCommand}"/>
                    <Button Classes="action" Content="Сбросить выбор" Command="{Binding ClearSelectionCommand}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="3" Classes="card" ClipToBounds="True">
    <Grid RowDefinitions="Auto,Auto,*"
          RowSpacing="8">
        <TextBlock Grid.Row="0"
                   Text="Список источников"
                   FontWeight="Bold"/>

        <TextBox Grid.Row="1" Watermark="Поиск по названию, громкости, артикуляции или свойствам" Text="{Binding SearchText}"/>
        <DataGrid VerticalAlignment="Stretch" Grid.Row="2" ItemsSource="{Binding Sources}" SelectedItem="{Binding SelectedSource}" AutoGenerateColumns="False" >
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="70"/>
                        <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="220"/>
                        <DataGridTextColumn Header="Volume" Binding="{Binding Volume}" Width="100"/>
                        <DataGridTextColumn Header="Article" Binding="{Binding Article}" Width="100"/>
                        <DataGridTextColumn Header="Properties" Binding="{Binding Properties}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
    </Grid>
</Border>

        <TextBlock Grid.Row="4" Text="{Binding StatusMessage}" Foreground="{DynamicResource AppStatusTextBrush}" TextWrapping="Wrap"/>
    </Grid>
</UserControl>
