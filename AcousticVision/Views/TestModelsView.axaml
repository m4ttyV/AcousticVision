<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AcousticVision.ViewModels"
             xmlns:models="using:AcousticVision.Models"
             x:Class="AcousticVision.Views.TestModelsView"
             x:DataType="vm:TestModelsViewModel">

    <Grid RowDefinitions="Auto,Auto,*,Auto" ColumnDefinitions="*" RowSpacing="12">
        <TextBlock Grid.Row="0" Text="Раздел: Тестовые модели" FontSize="20" FontWeight="Bold"/>

        <Border Grid.Row="1" Classes="card">
            <StackPanel Spacing="8">
                <TextBlock Text="Создание тестовой модели" FontWeight="Bold"/>
                <TextBlock Text="Помещение"/>
                <ComboBox ItemsSource="{Binding Rooms}" SelectedItem="{Binding SelectedRoom}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="models:RoomModel"><TextBlock Text="{Binding Name}"/></DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Text="Источник"/>
                <ComboBox ItemsSource="{Binding Sources}" SelectedItem="{Binding SelectedSource}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="models:SoundSource"><TextBlock Text="{Binding Name}"/></DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Text="Координаты источника"/>
                <TextBox Watermark="Например: (1.0; 1.0; 1.5)" Text="{Binding NewSourceLocation}"/>
                <TextBlock Text="Приёмник"/>
                <ComboBox ItemsSource="{Binding Receivers}" SelectedItem="{Binding SelectedReceiver}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="models:SoundReceiver"><TextBlock Text="{Binding Name}"/></DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Text="Координаты приёмника"/>
                <TextBox Watermark="Например: (4.0; 3.0; 1.2)" Text="{Binding NewReceiverLocation}"/>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Classes="action" Content="Добавить" Command="{Binding AddTestModelCommand}"/>
                    <Button Classes="action" Content="Обновить список" Command="{Binding LoadTestModelsCommand}"/>
                    <Button Classes="action" Content="Удалить выбранную" Command="{Binding DeleteSelectedCommand}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Classes="card">
            <StackPanel Spacing="8">
                <TextBlock Text="Список тестовых моделей" FontWeight="Bold"/>
                <DataGrid ItemsSource="{Binding TestModels}" SelectedItem="{Binding SelectedTestModel}" AutoGenerateColumns="False" Height="350">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="70"/>
                        <DataGridTextColumn Header="Помещение" Binding="{Binding Room.Name}" Width="180"/>
                        <DataGridTextColumn Header="Источник" Binding="{Binding Source.Name}" Width="180"/>
                        <DataGridTextColumn Header="Коорд. источника" Binding="{Binding SourceLocation}" Width="150"/>
                        <DataGridTextColumn Header="Приёмник" Binding="{Binding Receiver.Name}" Width="180"/>
                        <DataGridTextColumn Header="Коорд. приёмника" Binding="{Binding ReceiverLocation}" Width="150"/>
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="3" Text="{Binding StatusMessage}" Foreground="{DynamicResource AppStatusTextBrush}" TextWrapping="Wrap"/>
    </Grid>
</UserControl>
