<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AcousticVision.ViewModels"
             xmlns:models="using:AcousticVision.Models"
             x:Class="AcousticVision.Views.TestModelsView"
             x:DataType="vm:TestModelsViewModel">

    <Grid RowDefinitions="Auto,Auto,*,Auto"
          ColumnDefinitions="*"
          RowSpacing="12">

        <TextBlock Grid.Row="0"
                   Text="Раздел: Тестовые модели"
                   FontSize="20"
                   FontWeight="Bold"/>

        <Border Grid.Row="1" Classes="card">
            <StackPanel Spacing="8">
                <TextBlock Text="Создание и редактирование тестовой модели" FontWeight="Bold"/>

                <TextBlock Text="Помещение"/>
                <ComboBox ItemsSource="{Binding Rooms}"
                          SelectedItem="{Binding SelectedRoom}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="models:RoomModel">
                            <TextBlock Text="{Binding Name}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <TextBlock Text="Источник"/>
                <ComboBox ItemsSource="{Binding Sources}"
                          SelectedItem="{Binding SelectedSource}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="models:SoundSource">
                            <TextBlock Text="{Binding Name}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <TextBlock Text="Координаты источника"/>
                <TextBox Watermark="Например: (2.0; 1.5; 1.6)"
                         Text="{Binding NewSourceLocation}"/>

                <TextBlock Text="Приёмник"/>
                <ComboBox ItemsSource="{Binding Receivers}"
                          SelectedItem="{Binding SelectedReceiver}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="models:SoundReceiver">
                            <TextBlock Text="{Binding Name}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <TextBlock Text="Координаты приёмника"/>
                <TextBox Watermark="Например: (6.0; 2.5; 1.2)"
                         Text="{Binding NewReceiverLocation}"/>

                <TextBlock Text="Метод расчёта"/>
                <ComboBox ItemsSource="{Binding AnalysisMethodOptions}"
                          SelectedItem="{Binding SelectedAnalysisMethodOption}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding DisplayName}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <TextBlock Text="Чтобы изменить существующую тестовую модель, выберите её в таблице, поправьте поля выше и нажмите «Сохранить изменения»."
                           TextWrapping="Wrap"
                           FontSize="12"
                           Foreground="{DynamicResource AppSecondaryTextBrush}"/>

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Classes="action"
                            Content="Добавить"
                            Command="{Binding AddTestModelCommand}"/>

                    <Button Classes="action"
                            Content="Сохранить изменения"
                            Command="{Binding UpdateSelectedCommand}"/>

                    <Button Classes="action"
                            Content="Очистить форму"
                            Command="{Binding ClearFormCommand}"/>

                    <Button Classes="action"
                            Content="Обновить список"
                            Command="{Binding LoadTestModelsCommand}"/>

                    <Button Classes="action"
                            Content="Удалить выбранную"
                            Command="{Binding DeleteSelectedCommand}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Classes="card" ClipToBounds="True">
            <Grid RowDefinitions="Auto,*"
                  RowSpacing="8">
                <StackPanel Grid.Row="0" Spacing="8">
                    <TextBlock Text="Список тестовых моделей"
                               FontWeight="Bold"/>

                    <Grid  ColumnSpacing="8">
                        <TextBox 
                                 Watermark="Поиск по помещению, источнику, приёмнику, координатам или методу"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>

                  
                    </Grid>
                </StackPanel>

                <DataGrid Grid.Row="1"
                          VerticalAlignment="Stretch"
                          ItemsSource="{Binding TestModels}"
                          SelectedItem="{Binding SelectedTestModel}"
                          AutoGenerateColumns="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="70"/>
                        <DataGridTextColumn Header="Помещение" Binding="{Binding Room.Name}" Width="*"/>
                        <DataGridTextColumn Header="Источник" Binding="{Binding Source.Name}" Width="*"/>
                        <DataGridTextColumn Header="Приёмник" Binding="{Binding Receiver.Name}" Width="*"/>
                        <DataGridTextColumn Header="Координаты источника" Binding="{Binding SourceLocation}" Width="*"/>
                        <DataGridTextColumn Header="Координаты приёмника" Binding="{Binding ReceiverLocation}" Width="*"/>
                        <DataGridTextColumn Header="Метод" Binding="{Binding AnalysisMethodDisplayName}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <TextBlock Grid.Row="3"
                   Text="{Binding StatusMessage}"
                   Foreground="{DynamicResource AppStatusTextBrush}"
                   TextWrapping="Wrap"/>
    </Grid>
</UserControl>