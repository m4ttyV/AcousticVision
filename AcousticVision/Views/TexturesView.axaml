<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AcousticVision.ViewModels"
             x:Class="AcousticVision.Views.TexturesView"
             x:DataType="vm:TexturesViewModel">

    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" ColumnDefinitions="*"
          RowSpacing="12">

        <TextBlock Grid.Row="0"
                   Text="Раздел: Фактуры"
                   FontSize="20"
                   FontWeight="Bold"/>

        <Border Grid.Row="1" Classes="card">
            <StackPanel Spacing="8">
                <TextBlock Text="Добавление фактуры" FontWeight="Bold"/>

                <TextBox Watermark="Название фактуры"
                         Text="{Binding NewTextureName}"/>

                <TextBox Watermark="Коэффициент звукопоглощения (0..1)"
                         Text="{Binding NewNoiseCancelation}"/>

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Classes="action" Content="Добавить"
                            Command="{Binding AddTextureCommand}"/>

                    <Button Classes="action" Content="Обновить список"
                            Command="{Binding LoadCommand}"/>

                    <Button Classes="action" Content="Удалить выбранную"
                            Command="{Binding DeleteSelectedCommand}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Classes="card">
            <StackPanel Spacing="8">
                <TextBlock Text="Изменение выбранной фактуры" FontWeight="Bold"/>


                <TextBox Watermark="Название фактуры"
                         Text="{Binding EditTextureName}"/>

                <TextBox Watermark="Коэффициент звукопоглощения (0..1)"
                         Text="{Binding EditNoiseCancelation}"/>

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Classes="action" Content="Сохранить изменения"
                            Command="{Binding UpdateSelectedCommand}"/>

                    <Button Classes="action" Content="Сбросить выбор"
                            Command="{Binding ClearSelectionCommand}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="3" Classes="card" ClipToBounds="True">
    <Grid RowDefinitions="Auto,Auto,*"
          RowSpacing="8">
        <TextBlock Grid.Row="0"
                   Text="Список фактур"
                   FontWeight="Bold"/>
        
       <TextBox  Grid.Row="1"
                Watermark="Поиск по названию или коэффициенту"
                         Text="{Binding SearchText}"/>

        <DataGrid VerticalAlignment="Stretch" Grid.Row="2" ItemsSource="{Binding Textures}"
                          SelectedItem="{Binding SelectedTexture}"
                          AutoGenerateColumns="False" >
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="80"/>
                        <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="Коэффициент" Binding="{Binding NoiseCancelation}" Width="160"/>
                    </DataGrid.Columns>
                </DataGrid>
    </Grid>
</Border>

        <TextBlock Grid.Row="4"
                   Text="{Binding StatusMessage}"
                   Foreground="{DynamicResource AppStatusTextBrush}"
                   TextWrapping="Wrap"/>
    </Grid>
</UserControl>
