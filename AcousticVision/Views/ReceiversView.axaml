<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AcousticVision.ViewModels"
             x:Class="AcousticVision.Views.ReceiversView"
             x:DataType="vm:ReceiversViewModel">

    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" ColumnDefinitions="*" RowSpacing="12">
        <TextBlock Grid.Row="0" Text="Раздел: Приёмники звука" FontSize="20" FontWeight="Bold"/>

        <Border Grid.Row="1" Classes="card">
            <StackPanel Spacing="8">
                <TextBlock Text="Добавление приёмника" FontWeight="Bold"/>
                <TextBox Watermark="Название приёмника" Text="{Binding NewReceiverName}"/>
                <TextBox Watermark="Дополнительные свойства" Text="{Binding NewProperties}"/>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Classes="action" Content="Добавить" Command="{Binding AddReceiverCommand}"/>
                    <Button Classes="action" Content="Обновить список" Command="{Binding LoadCommand}"/>
                    <Button Classes="action" Content="Удалить выбранный" Command="{Binding DeleteSelectedCommand}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Classes="card">
            <StackPanel Spacing="8">
                <TextBlock Text="Изменение выбранного приёмника" FontWeight="Bold"/>
                <TextBox Watermark="Название приёмника" Text="{Binding EditReceiverName}"/>
                <TextBox Watermark="Дополнительные свойства" Text="{Binding EditProperties}"/>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Classes="action" Content="Сохранить изменения" Command="{Binding UpdateSelectedCommand}"/>
                    <Button Classes="action" Content="Сбросить выбор" Command="{Binding ClearSelectionCommand}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="3" Classes="card" ClipToBounds="True">
    <Grid RowDefinitions="Auto,Auto,*"
          RowSpacing="8">
        <TextBlock Grid.Row="0"
                   Text="Список приёмников"
                   FontWeight="Bold"/>
                <TextBox Grid.Row="1" Watermark="Поиск по названию или свойствам" Text="{Binding SearchText}"/>

        <DataGrid VerticalAlignment="Stretch" Grid.Row="2" ItemsSource="{Binding Receivers}" SelectedItem="{Binding SelectedReceiver}" AutoGenerateColumns="False" >
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="70"/>
                        <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="220"/>
                        <DataGridTextColumn Header="Properties" Binding="{Binding Properties}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
    </Grid>
</Border>

        <TextBlock Grid.Row="4" Text="{Binding StatusMessage}" Foreground="{DynamicResource AppStatusTextBrush}" TextWrapping="Wrap"/>
    </Grid>
</UserControl>
