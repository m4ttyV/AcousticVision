<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:AcousticVision.ViewModels"
    xmlns:views="using:AcousticVision.Views"
    x:Class="AcousticVision.Views.MainWindow"
    x:DataType="vm:MainWindowViewModel"
    Title="AcousticVision"
    Width="1280"
    Height="820"
    Background="{DynamicResource AppWindowBackgroundBrush}">

    <Window.DataTemplates>
        <DataTemplate DataType="vm:OverviewViewModel"><views:OverviewView/></DataTemplate>
        <DataTemplate DataType="vm:RoomsViewModel"><views:RoomsView/></DataTemplate>
        <DataTemplate DataType="vm:RoomSurfacesViewModel"><views:RoomSurfacesView/></DataTemplate>
        <DataTemplate DataType="vm:MaterialsViewModel"><views:MaterialsView/></DataTemplate>
        <DataTemplate DataType="vm:TexturesViewModel"><views:TexturesView/></DataTemplate>
        <DataTemplate DataType="vm:SourcesViewModel"><views:SourcesView/></DataTemplate>
        <DataTemplate DataType="vm:ReceiversViewModel"><views:ReceiversView/></DataTemplate>
        <DataTemplate DataType="vm:TestModelsViewModel"><views:TestModelsView/></DataTemplate>
        <DataTemplate DataType="vm:AnalysisViewModel"><views:AnalysisView/></DataTemplate>
    </Window.DataTemplates>

    <Grid ColumnDefinitions="280,*" RowDefinitions="72,*">
        <Border Grid.ColumnSpan="2" Background="{DynamicResource AppHeaderBackgroundBrush}" Padding="20,14">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel>
                    <TextBlock Text="AcousticVision" Foreground="{DynamicResource AppHeaderPrimaryTextBrush}" FontSize="24" FontWeight="Bold"/>
                    <TextBlock Text="Анализ акустических характеристик речи" Foreground="{DynamicResource AppHeaderSecondaryTextBrush}" FontSize="13"/>
                </StackPanel>
                <TextBlock Grid.Column="1" VerticalAlignment="Center" Foreground="{DynamicResource AppHeaderSecondaryTextBrush}" FontSize="13"
                           Text="C# / Avalonia / SQLite / EF Core"/>
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="{DynamicResource AppSidebarBackgroundBrush}" Padding="16">
            <ScrollViewer>
                <StackPanel Spacing="4">
                    <TextBlock Text="Навигация" Foreground="{DynamicResource AppSidebarTextBrush}" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <Button Classes="nav" Content="Обзор" Command="{Binding ShowOverviewCommand}"/>
                    <Button Classes="nav" Content="Помещения" Command="{Binding ShowRoomsCommand}"/>
                    <Button Classes="nav" Content="Поверхности помещения" Command="{Binding ShowRoomSurfacesCommand}"/>
                    <Button Classes="nav" Content="Материалы" Command="{Binding ShowMaterialsCommand}"/>
                    <Button Classes="nav" Content="Фактуры" Command="{Binding ShowTexturesCommand}"/>
                    <Button Classes="nav" Content="Источники" Command="{Binding ShowSourcesCommand}"/>
                    <Button Classes="nav" Content="Приёмники" Command="{Binding ShowReceiversCommand}"/>
                    <Button Classes="nav" Content="Тест-модели" Command="{Binding ShowTestModelsCommand}"/>
                    <Button Classes="nav" Content="Анализ" Command="{Binding ShowAnalysisCommand}"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Border Grid.Column="1" Grid.Row="1" Padding="20" Background="{DynamicResource AppWindowBackgroundBrush}">
            <ContentControl Content="{Binding CurrentViewModel}"/>
        </Border>
    </Grid>
</Window>
